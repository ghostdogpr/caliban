.home .hero img {
  max-height: 200px !important;
}

.home {
  position: relative;
}

.home .hero {
  padding-top: 2.25rem;
}

.home .stack-badge {
  position: absolute;
  top: 5rem;
  left: 50%;
  transform: translateX(-50%);
  padding: 0.2rem 0.75rem;
  border-radius: 999px;
  background: #f3f4f5;
  color: #4e6e8e;
  font-size: 0.8rem;
  font-weight: 500;
  white-space: nowrap;
}

.home .stack-badge:hover {
  color: $accentColor;
  text-decoration: none;
}
